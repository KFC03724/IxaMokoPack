{
  "manifest_version": 3,
  "name": "IxaMoko",
  "author": "hoge",
  "version": "10.30.202511.2",
  "description": "Tool of Sengoku-ixa(2025/12/09)",
  "icons": {
    "16": "/assets/ixanyan16.png",
    "48": "/assets/ixanyan48.png",
    "128": "/assets/ixanyan128.png"
  },
  "permissions": ["contextMenus"],
  "content_scripts": [
    {
      "all_frames": true,
      "matches": ["https://*.sengokuixa.jp/world/*"],
      "exclude_matches": ["https://cache.sengokuixa.jp/world/*"],
      "js": ["inject_login.js"],
      "run_at": "document_start"
    },
    {
      "all_frames": true,
      "run_at": "document_end",
      "matches": ["https://*.sengokuixa.jp/*"],
      "exclude_matches": [
        "https://sengokuixa.jp/*",
        "https://cache.sengokuixa.jp/*",
        "http://h.sengokuixa.jp/*",
        "https://m.sengokuixa.jp/*",
        "https://*.sengokuixa.jp/world/*",
        "https://*.sengokuixa.jp/false/*",
        "https://*.sengokuixa.jp/maintenance/",
        "https://*.sengokuixa.jp/map_if.php*"
      ],
      "js": ["inject_moko.js"],
      "css": ["css/main.css"]
    },
    {
      "all_frames": true,
      "run_at": "document_idle",
      "matches": ["https://*.sengokuixa.jp/war/war_ranking.php"],
      "js": ["ranking.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "contents/*",
        "userscript/*"
      ],
      "matches": [
        "https://*.sengokuixa.jp/*"
      ]
    }
  ]
}